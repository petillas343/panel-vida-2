<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AETHER // v2.2</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { box-sizing: border-box; }
    body { min-height: 100vh; margin: 0; color: #f3f4f6; background: #05050a radial-gradient(circle at 15% 10%, rgba(168,85,247,.15), transparent 40%); font-family: system-ui, sans-serif; }
    .glass { background: rgba(14,14,26,.94); border: 1px solid rgba(168,85,247,.3); box-shadow: 0 10px 30px rgba(0,0,0,.5); }
    .neon { color: #e9d5ff; text-shadow: 0 0 12px rgba(168,85,247,.75); }
    .neon-line { height: 2px; background: linear-gradient(90deg, transparent, #a855f7, #06b6d4, transparent); }
    .field { width: 100%; color: #f3f4f6; background: #080812; border: 1px solid rgba(168,85,247,.35); border-radius: 10px; padding: 10px 12px; font-size: 14px; outline: none; }
    .btn-primary { color: #fff; background: linear-gradient(100deg, #7e22ce, #9333ea); border: 1px solid rgba(216,180,254,.4); border-radius: 10px; padding: 11px 14px; font-weight: 600; font-size: 14px; cursor: pointer; }
    .btn-primary:active, .btn-secondary:active, .btn-filter:active { transform: scale(0.97); }
    .btn-secondary { color: #d8b4fe; background: rgba(168,85,247,.14); border: 1px solid rgba(168,85,247,.4); border-radius: 10px; padding: 11px 14px; font-weight: 600; font-size: 14px; cursor: pointer; }
    .btn-filter { color: #d8b4fe; background: rgba(168,85,247,.1); border: 1px solid rgba(168,85,247,.3); border-radius: 8px; padding: 6px 10px; font-size: 12px; cursor: pointer; }
    .btn-filter.active-filter { background: rgba(168,85,247,.38); border-color: #a855f7; color: #fff; }
    .task-row { border: 1px solid rgba(255,255,255,.08); background: rgba(8,8,16,.7); border-radius: 12px; }
    .task-row.overdue { border-color: rgba(244,63,94,.5); background: rgba(244,63,94,.05); }
    .task-row.completed { opacity: .6; }
    .task-row.completed .task-title { text-decoration: line-through; color: #64748b; }
    .hidden { display: none !important; }
  </style>

  <!-- MOTOR PRINCIPAL EN EL HEAD PARA QUE NUNCA SE CORTE -->
  <script>
    var SB_URL = "https://dzyhecukaiujbuvsemtf.supabase.co";
    var SB_KEY = "sb_publishable_Iv1sS0zzisomBIRZwp_GwA_dPWksAwl";
    var token = null, user = null, tasks = [], stFilter = "all";

    function $(id) { return document.getElementById(id); }

    function msg(id, text, isErr) {
      var b = $(id);
      if (!b) return;
      if (!text) { b.classList.add("hidden"); return; }
      b.classList.remove("hidden");
      b.textContent = text;
      b.className = "mt-3 p-3 rounded-xl border text-xs font-mono break-words " +
        (isErr ? "bg-rose-500/20 border-rose-500 text-rose-200" : "bg-emerald-500/20 border-emerald-500 text-emerald-200");
    }

    window.onerror = function(m, u, l) { msg("authMessageBox", "Error JS L" + l + ": " + m, true); };

    async function aetherAuth(mode) {
      var email = $("authEmail").value.trim();
      var password = $("authPassword").value;
      msg("authMessageBox", "Ejecutando " + mode + "...", false);

      if (!email || password.length < 6) {
        msg("authMessageBox", "Escribe tu email y una contraseña de mínimo 6 caracteres.", true);
        return;
      }

      var path = (mode === "login") ? "/auth/v1/token?grant_type=password" : "/auth/v1/signup";
      try {
        var r = await fetch(SB_URL + path, {
          method: "POST",
          headers: { "Content-Type": "application/json", "apikey": SB_KEY },
          body: JSON.stringify({ email: email, password: password })
        });
        var d = await r.json();
        if (!r.ok) {
          msg("authMessageBox", "Error Supabase: " + (d.msg || d.error_description || d.message || JSON.stringify(d)), true);
          return;
        }
        if (d.access_token && d.user) {
          token = d.access_token;
          user = d.user;
          try { localStorage.setItem("aether_token", token); localStorage.setItem("aether_user", JSON.stringify(user)); } catch(e){}
          openApp();
        } else {
          msg("authMessageBox", "Cuenta lista. Toca ahora el botón 1 (Iniciar sesión).", false);
        }
      } catch (e) {
        msg("authMessageBox", "Fallo de red: " + e.message, true);
      }
    }

    function openApp() {
      $("authSection").classList.add("hidden");
      $("appSection").classList.remove("hidden");
      $("logoutButton").classList.remove("hidden");
      $("userEmail").textContent = user.email || "Activo";
      loadTasks();
    }

    function aetherLogout() {
      try { localStorage.clear(); } catch(e){}
      token = null; user = null; tasks = [];
      $("appSection").classList.add("hidden");
      $("logoutButton").classList.add("hidden");
      $("authSection").classList.remove("hidden");
    }

    async function loadTasks() {
      if (!token) return;
      try {
        var r = await fetch(SB_URL + "/rest/v1/tasks?select=*&order=created_at.desc", {
          headers: { "apikey": SB_KEY, "Authorization": "Bearer " + token }
        });
        if (r.status === 401) { aetherLogout(); return; }
        var d = await r.json();
        if (!r.ok) { msg("taskMessageBox", "Error cargando: " + (d.message || r.status), true); return; }
        tasks = Array.isArray(d) ? d : [];
        drawTasks();
      } catch (e) { msg("taskMessageBox", "Error red: " + e.message, true); }
    }

    async function saveTask() {
      var title = $("taskTitle").value.trim();
      if (!title) { msg("taskMessageBox", "Ponle un título a la tarea.", true); return; }
      var editId = $("editTaskId").value;

      var body = {
        title: title,
        description: $("taskDescription").value.trim(),
        priority: $("taskPriority").value,
        status: $("taskStatus").value,
        due_date: $("taskDueDate").value || null,
        category: $("taskCategory").value
      };
      if (!editId) body.user_id = user.id;

      var url = SB_URL + "/rest/v1/tasks" + (editId ? "?id=eq." + editId : "");
      var method = editId ? "PATCH" : "POST";

      msg("taskMessageBox", "Guardando...", false);
      try {
        var r = await fetch(url, {
          method: method,
          headers: { "Content-Type": "application/json", "apikey": SB_KEY, "Authorization": "Bearer " + token, "Prefer": "return=representation" },
          body: JSON.stringify(body)
        });
        var d = await r.json();

        // Fallback automático si el usuario aún no creó la columna 'category' en Supabase
        if (!r.ok && d.message && d.message.indexOf("category") !== -1) {
          delete body.category;
          r = await fetch(url, {
            method: method,
            headers: { "Content-Type": "application/json", "apikey": SB_KEY, "Authorization": "Bearer " + token, "Prefer": "return=representation" },
            body: JSON.stringify(body)
          });
          d = await r.json();
        }

        if (!r.ok) { msg("taskMessageBox", "Error: " + (d.message || JSON.stringify(d)), true); return; }
        cancelEdit();
        msg("taskMessageBox", "", false);
        loadTasks();
      } catch (e) { msg("taskMessageBox", "Error: " + e.message, true); }
    }

    function editTask(id) {
      var t = tasks.find(function(x) { return x.id === id; });
      if (!t) return;
      $("editTaskId").value = t.id;
      $("taskTitle").value = t.title || "";
      $("taskDescription").value = t.description || "";
      $("taskCategory").value = t.category || "general";
      $("taskPriority").value = t.priority || "medium";
      $("taskStatus").value = t.status || "pending";
      $("taskDueDate").value = t.due_date || "";
      $("formHeading").textContent = "Editando Tarea";
      $("saveTaskButton").textContent = "Guardar cambios";
      $("cancelEditBtn").classList.remove("hidden");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function cancelEdit() {
      $("editTaskId").value = "";
      $("taskTitle").value = "";
      $("taskDescription").value = "";
      $("taskCategory").value = "general";
      $("taskPriority").value = "medium";
      $("taskStatus").value = "pending";
      $("taskDueDate").value = "";
      $("formHeading").textContent = "Nueva Tarea";
      $("saveTaskButton").textContent = "+ Guardar tarea";
      $("cancelEditBtn").classList.add("hidden");
    }

    async function setTaskStatus(id, st) {
      await fetch(SB_URL + "/rest/v1/tasks?id=eq." + id, {
        method: "PATCH",
        headers: { "Content-Type": "application/json", "apikey": SB_KEY, "Authorization": "Bearer " + token },
        body: JSON.stringify({ status: st })
      });
      loadTasks();
    }

    async function removeTask(id) {
      if (!window.confirm("¿Borrar esta tarea?")) return;
      await fetch(SB_URL + "/rest/v1/tasks?id=eq." + id, {
        method: "DELETE",
        headers: { "apikey": SB_KEY, "Authorization": "Bearer " + token }
      });
      loadTasks();
    }

    function setTab(st, btnId) {
      stFilter = st;
      ["stAll", "stPending", "stProgress", "stCompleted"].forEach(function(id) {
        $(id).classList.toggle("active-filter", id === btnId);
      });
      drawTasks();
    }

    function isOverdue(t) {
      if (!t.due_date || t.status === "completed") return false;
      return t.due_date < new Date().toISOString().split("T")[0];
    }

    function drawTasks() {
      var list = $("taskList");
      list.innerHTML = "";
      var q = $("searchInput").value.trim().toLowerCase();
      var catF = $("filterCategory").value;
      var prioF = $("filterPriority").value;
      var sortM = $("sortBy").value;

      $("sidebarTaskCount").textContent = tasks.length;
      $("kpiPending").textContent = tasks.filter(function(t){ return t.status === "pending"; }).length;
      $("kpiInProgress").textContent = tasks.filter(function(t){ return t.status === "in_progress"; }).length;
      $("kpiCompleted").textContent = tasks.filter(function(t){ return t.status === "completed"; }).length;
      $("kpiOverdue").textContent = tasks.filter(isOverdue).length;

      var shown = tasks.filter(function(t) {
        if (stFilter !== "all" && t.status !== stFilter) return false;
        if (catF !== "all" && (t.category || "general") !== catF) return false;
        if (prioF !== "all" && t.priority !== prioF) return false;
        if (q && (t.title || "").toLowerCase().indexOf(q) === -1 && (t.description || "").toLowerCase().indexOf(q) === -1) return false;
        return true;
      });

      var pw = { high: 3, medium: 2, low: 1 };
      shown.sort(function(a, b) {
        if (sortM === "priority_desc") return (pw[b.priority] || 2) - (pw[a.priority] || 2);
        if (sortM === "due_asc") return (a.due_date || "9999").localeCompare(b.due_date || "9999");
        return (b.created_at || "").localeCompare(a.created_at || "");
      });

      $("emptyState").classList.toggle("hidden", shown.length > 0);

      shown.forEach(function(t) {
        var done = (t.status === "completed"), over = isOverdue(t);
        var row = document.createElement("div");
        row.className = "task-row p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 " + (done ? "completed " : "") + (over ? "overdue" : "");

        var nextSt = (t.status === "in_progress") ? "pending" : "in_progress";
        var nextLabel = (t.status === "in_progress") ? "⏸ Pausar" : "⚡ En curso";

        row.innerHTML =
          '<div class="flex items-start gap-3 flex-1 min-w-0">' +
            '<input type="checkbox" ' + (done ? "checked" : "") + ' class="mt-1 w-4 h-4 accent-purple-500" onchange="setTaskStatus(\'' + t.id + '\', this.checked ? \'completed\' : \'pending\')">' +
            '<div class="min-w-0 flex-1">' +
              '<p class="task-title text-sm font-bold text-white break-words"></p>' +
              (t.description ? '<p class="task-desc text-xs text-slate-400 mt-0.5 break-words"></p>' : '') +
              '<div class="flex flex-wrap gap-1.5 mt-2 text-[10px] font-mono">' +
                '<span class="px-2 py-0.5 rounded bg-purple-500/20 text-purple-200">' + (t.status === "in_progress" ? "⚡ EN CURSO" : (done ? "✅ HECHA" : "⏳ PENDIENTE")) + '</span>' +
                '<span class="px-2 py-0.5 rounded bg-white/10 text-slate-200">PRIO: ' + (t.priority || "medium").toUpperCase() + '</span>' +
                '<span class="px-2 py-0.5 rounded bg-white/5 text-slate-300">' + (t.category || "general").toUpperCase() + '</span>' +
                (t.due_date ? '<span class="px-2 py-0.5 rounded ' + (over ? 'bg-rose-500/30 text-rose-200 font-bold' : 'bg-white/5 text-slate-400') + '">' + (over ? '⚠ VENCIDA: ' : '📅 ') + t.due_date + '</span>' : '') +
              '</div>' +
            '</div>' +
          '</div>' +
          '<div class="flex gap-1.5 self-end sm:self-center">' +
            (!done ? '<button type="button" class="btn-filter" onclick="setTaskStatus(\'' + t.id + '\',\'' + nextSt + '\')">' + nextLabel + '</button>' : '') +
            '<button type="button" class="btn-filter" onclick="editTask(\'' + t.id + '\')">Editar</button>' +
            '<button type="button" class="btn-filter text-rose-300" onclick="removeTask(\'' + t.id + '\')">Borrar</button>' +
          '</div>';

        row.querySelector(".task-title").textContent = t.title;
        if (t.description) row.querySelector(".task-desc").textContent = t.description;
        list.appendChild(row);
      });
    }

    window.addEventListener("DOMContentLoaded", function() {
      $("connectionStatus").textContent = "● MOTOR v2.2 ACTIVO";
      $("connectionStatus").className = "text-xs font-mono text-emerald-400";
      try {
        var st = localStorage.getItem("aether_token");
        var su = JSON.parse(localStorage.getItem("aether_user") || "null");
        if (st && su) { token = st; user = su; openApp(); }
      } catch(e){}
    });
  </script>
</head>
<body>
  <div class="neon-line w-full"></div>

  <header class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
    <div>
      <h1 class="font-bold tracking-widest text-xl neon">AETHER</h1>
      <p class="text-[10px] text-slate-400 font-mono">PERSONAL LIFE OS // v2.2</p>
    </div>
    <div class="flex items-center gap-3">
      <span id="connectionStatus" class="text-xs font-mono text-amber-400">● ESPERANDO JS...</span>
      <button id="logoutButton" type="button" onclick="aetherLogout()" class="btn-filter hidden">Salir</button>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 pb-16">
    <!-- AUTH -->
    <section id="authSection" class="max-w-md mx-auto mt-6">
      <div class="glass rounded-2xl p-6">
        <p class="text-xs font-mono text-purple-400">IDENTITY // ACCESS</p>
        <h2 class="text-2xl font-bold mt-1 mb-4">Acceso a AETHER</h2>
        <div class="space-y-3">
          <input id="authEmail" class="field" type="email" placeholder="Email (tu@email.com)">
          <input id="authPassword" class="field" type="password" placeholder="Contraseña (mín. 6 caracteres)">
          <button type="button" onclick="aetherAuth('login')" class="btn-primary w-full">1. Iniciar sesión</button>
          <button type="button" onclick="aetherAuth('signup')" class="btn-secondary w-full">2. Crear cuenta nueva</button>
        </div>
        <div id="authMessageBox" class="mt-4 p-3 rounded-xl border text-xs font-mono bg-purple-500/10 border-purple-500/30 text-purple-200">
          Motor v2.2 listo. Introduce tus datos y toca un botón.
        </div>
      </div>
    </section>

    <!-- APP -->
    <section id="appSection" class="hidden">
      <div class="grid grid-cols-1 lg:grid-cols-[210px_1fr] gap-4 mt-2">
        <aside class="glass rounded-2xl p-4 h-fit">
          <p class="text-[10px] text-purple-400 font-mono">SESIÓN ACTIVA</p>
          <p id="userEmail" class="text-xs text-slate-200 mt-1 break-all font-mono"></p>
          <div class="mt-4 px-3 py-2 rounded-xl bg-purple-500/20 border border-purple-500/40 text-purple-200 text-xs font-semibold flex justify-between">
            <span>01 // Tasks</span><span id="sidebarTaskCount" class="font-mono">0</span>
          </div>
        </aside>

        <div class="space-y-4 min-w-0">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
            <div class="glass rounded-xl p-3"><p class="text-[10px] font-mono text-slate-400">PENDIENTES</p><p id="kpiPending" class="text-2xl font-mono font-bold text-purple-300">0</p></div>
            <div class="glass rounded-xl p-3"><p class="text-[10px] font-mono text-cyan-400">EN CURSO</p><p id="kpiInProgress" class="text-2xl font-mono font-bold text-cyan-300">0</p></div>
            <div class="glass rounded-xl p-3"><p class="text-[10px] font-mono text-emerald-400">HECHAS</p><p id="kpiCompleted" class="text-2xl font-mono font-bold text-emerald-300">0</p></div>
            <div class="glass rounded-xl p-3"><p class="text-[10px] font-mono text-rose-400">VENCIDAS</p><p id="kpiOverdue" class="text-2xl font-mono font-bold text-rose-400">0</p></div>
          </div>

          <section class="glass rounded-2xl p-4 sm:p-5">
            <div class="flex justify-between items
